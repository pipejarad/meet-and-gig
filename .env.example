# =============================================================================
# Meet & Gig — Variables de entorno
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear el archivo .env
# =============================================================================

# --------------------------------------------------------------------------
# Seguridad (obligatorio en todos los entornos)
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# --------------------------------------------------------------------------
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-segura-generada

# Hosts permitidos (separados por coma)
# Desarrollo: localhost,127.0.0.1
# Producción: tudominio.com,www.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------------------------------------
# Email
# --------------------------------------------------------------------------
# Desarrollo: no necesitas cambiar esto, development.py usa console backend
DEFAULT_FROM_EMAIL=noreply@meetandgig.com
SITE_URL=http://127.0.0.1:8000

# Producción (ignorado en development.py):
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_usuario@ejemplo.com
EMAIL_HOST_PASSWORD=tu_password_smtp

# --------------------------------------------------------------------------
# Base de datos
# Solo requerida en producción. development.py usa SQLite automáticamente.
# Formato: postgres://usuario:password@host:5432/nombre_db
# --------------------------------------------------------------------------
DATABASE_URL=postgres://meetandgig_user:password@localhost:5432/meetandgig_db

# --------------------------------------------------------------------------
# Seguridad HTTPS (solo producción)
# --------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Orígenes confiables para CSRF (solo producción, separados por coma).
# Obligatorio detrás del proxy de Railway o los POST fallan con 403.
CSRF_TRUSTED_ORIGINS=https://tuapp.up.railway.app

# --------------------------------------------------------------------------
# Media en almacenamiento S3-compatible (solo producción)
# El disco de Railway es efímero: sin esto, los uploads se pierden en cada
# deploy. Si AWS_STORAGE_BUCKET_NAME está vacío, se usa el disco local.
# Cloudflare R2: endpoint https://<account_id>.r2.cloudflarestorage.com y región 'auto'
# Backblaze B2:  endpoint https://s3.<region>.backblazeb2.com y región igual a <region>
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# --------------------------------------------------------------------------
# Asistente de IA de biografías (ROADMAP §8)
# Sin ANTHROPIC_API_KEY el asistente se desactiva con un aviso (no rompe nada).
# Obtener la key en https://console.anthropic.com — modelo económico por defecto.
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=
BIO_IA_MODELO=claude-haiku-4-5

# --------------------------------------------------------------------------
# Notas para Railway (Bloque 5)
# --------------------------------------------------------------------------
# - Definir DJANGO_SETTINGS_MODULE=meetandgig.settings.production (los entry
#   points wsgi/asgi ya lo asumen por defecto, pero conviene ser explícito).
# - El add-on de PostgreSQL inyecta DATABASE_URL automáticamente.
# - Comando de pre-deploy sugerido: python manage.py migrate
# - Si el proveedor SMTP usa puerto 465, definir EMAIL_USE_SSL=True y
#   EMAIL_USE_TLS=False.
